<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's exceptions for Groundwork (build_macos.sh, used only with a Developer ID).
     Python and the llama.cpp runtime map executable memory; the voice commands need the microphone.
     Nothing else: no JIT for the app itself (WebKit's runs in its own process), no library-validation exception,
     because every library in the bundle is signed with the same identity. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
