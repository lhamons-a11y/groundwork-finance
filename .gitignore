# Groundwork .gitignore
# Never commit real financial data or build noise.

# Databases — real data lives in %LOCALAPPDATA%\Groundwork, but belt+suspenders
*.db
*.db-journal
*.sqlite

# Deploy machinery
staging/
backups/

# Python
__pycache__/
*.pyc
venv/
.venv/

# PyInstaller build output (the .spec file IS committed — it's config)
build/
dist/

# Vendored binaries (Ollama installer + model weights, multi-GB) and built
# installer output — regenerated by build.bat, never source, never committed
vendor/
installer_output/
installer/installer/

# Claude Code local settings — machine-specific, and this one has a live
# EIA API key baked into its permission strings (curl commands with
# api_key=... in the URL). Never commit.
.claude/settings.local.json

# Real financial data / PII, caught before first commit (2026-07-24):
# a real statement PDF, a diagnostic dump with real debt balances, and an
# import-rules file naming the developer's actual bank/credit union and employer.
*.pdf
diag_output.txt
home_install_import_rules.json

# Generated one-off debug/tree dumps — noise, not source
audit_search.txt
groundwork_tree.txt

# Editor noise
.vscode/
*.swp
Thumbs.db

# Generated by llm_runtime_spike.py (machine-specific measurements)
llm_runtime_spike_results.json
llm_model_eval_results.json
# The pinned model, fetched by fetch_model.py for a build (item 33 Q5) - never committed
model_dl/

# item 95: build_engine_wheel.bat output
engine_wheel/
